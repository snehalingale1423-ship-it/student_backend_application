# StudbuddY Frontend — Environment Variables
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored — do NOT commit real values.
#
# -------------------------------------------------------
# VITE_API_BASE_URL
# The URL of your Spring Boot backend.
# For local development: http://localhost:8080
# The Vite dev server runs on port 3000; the backend on 8080.
# -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# -------------------------------------------------------
# GEMINI_API_KEY — only needed if the Gemini AI features are used
# -------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
